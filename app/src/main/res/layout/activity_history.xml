<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    tools:context=".HistoryActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHistory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/viewHeaderGradient"
                android:layout_width="match_parent"
                android:layout_height="465dp"
                android:background="@drawable/bg_history_header_gradient" />

            <LinearLayout
                android:id="@+id/layoutScrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <!-- 1. Header, cal Mingguan, & Water Streak -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvHistoryTitle"
                                style="@style/Widget.MTS.Text.Heading2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Your hydration story"
                                android:textSize="24sp" />

                            <TextView
                                android:id="@+id/tvHistorySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/nunito_semibold"
                                app:fontFamily="@font/nunito_semibold"
                                android:text="Every kind of sip, in one place."
                                android:textColor="@color/muted"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnCalendar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Select date"
                            android:src="@drawable/ic_calendar" />
                    </LinearLayout>
=
                    <LinearLayout
                        android:id="@+id/layoutWeekDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="horizontal" />

                    <ImageView
                        android:id="@+id/ivStreakOtter"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        android:contentDescription="Water streak mascot"
                        android:src="@drawable/img_otter_streak" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito_bold"
                        app:fontFamily="@font/nunito_bold"
                        android:text="Water Streak"
                        android:textColor="@color/on_background"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvStreakDays"
                        style="@style/Widget.MTS.Text.Heading2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="6 days"
                        android:textSize="32sp" />
                </LinearLayout>

                <!-- 2. card summary harian (1,200 ml / 60%) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvSelectedDateLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extrabold"
                                    app:fontFamily="@font/nunito_extrabold"
                                    android:text="TODAY · NOV 6, 2026"
                                    android:textColor="@color/muted"
                                    android:textSize="11sp" />

                                <TextView
                                    android:id="@+id/tvHistoryTotalMl"
                                    style="@style/Widget.MTS.Text.Heading2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="1,200 ml"
                                    android:textSize="32sp" />

                                <TextView
                                    android:id="@+id/tvHistoryGoal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:text="of 2,000 ml daily goal"
                                    android:textColor="@color/muted"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/accent_warning"
                                app:cardCornerRadius="20dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/tvHistoryPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_extrabold"
                                    app:fontFamily="@font/nunito_extrabold"
                                    android:paddingHorizontal="18dp"
                                    android:paddingVertical="8dp"
                                    android:text="60%"
                                    android:textColor="@color/on_background"
                                    android:textSize="16sp" />
                            </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvConsumedCredited"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/nunito_bold"
                            app:fontFamily="@font/nunito_bold"
                            android:text="1,250 ml consumed · 1,200 ml credited"
                            android:textColor="@color/on_background"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. card Grafik Rhythmny (Day / Month / Year) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Tab Filter: Day | Month | Year -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            app:cardBackgroundColor="#EDF7FA"
                            app:cardCornerRadius="22dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#CBE8F0"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:padding="4dp">

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardTabDay"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@color/wave_blue"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <TextView
                                        android:id="@+id/tabDay"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/nunito_bold"
                                        app:fontFamily="@font/nunito_bold"
                                        android:gravity="center"
                                        android:text="Day"
                                        android:textColor="@color/white"
                                        android:textSize="14sp" />
                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardTabMonth"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <TextView
                                        android:id="@+id/tabMonth"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/nunito_semibold"
                                        app:fontFamily="@font/nunito_semibold"
                                        android:gravity="center"
                                        android:text="Month"
                                        android:textColor="@color/on_background"
                                        android:textSize="14sp" />
                                </com.google.android.material.card.MaterialCardView>

                                <com.google.android.material.card.MaterialCardView
                                    android:id="@+id/cardTabYear"
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"
                                    app:cardBackgroundColor="@android:color/transparent"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <TextView
                                        android:id="@+id/tabYear"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:fontFamily="@font/nunito_semibold"
                                        app:fontFamily="@font/nunito_semibold"
                                        android:gravity="center"
                                        android:text="Year"
                                        android:textColor="@color/on_background"
                                        android:textSize="14sp" />
                                </com.google.android.material.card.MaterialCardView>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRhythmTitle"
                                style="@style/Widget.MTS.Text.Heading2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Today’s rhythm"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_regular"
                                app:fontFamily="@font/nunito_regular"
                                android:text="ml"
                                android:textColor="@color/muted"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Bar Chart -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="32dp"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:paddingBottom="20dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:text="800"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:gravity="center_vertical"
                                    android:text="400"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:text="0"
                                    android:textColor="@color/muted"
                                    android:textSize="10sp" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="vertical"
                                    android:paddingTop="6dp"
                                    android:paddingBottom="20dp">

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="#E8F1F4" />

                                    <Space
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="#E8F1F4" />

                                    <Space
                                        android:layout_width="match_parent"
                                        android:layout_height="0dp"
                                        android:layout_weight="1" />

                                    <View
                                        android:layout_width="match_parent"
                                        android:layout_height="1dp"
                                        android:background="#E8F1F4" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/chartBarsContainer"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="bottom"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar08"
                                            android:layout_width="24dp"
                                            android:layout_height="84dp"
                                            app:cardBackgroundColor="@color/wave_blue"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="08"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar10"
                                            android:layout_width="24dp"
                                            android:layout_height="38dp"
                                            app:cardBackgroundColor="@color/wave_blue"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="10"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar12"
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            app:cardBackgroundColor="@color/coffee_brown"
                                            app:cardCornerRadius="12dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="12"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar14"
                                            android:layout_width="24dp"
                                            android:layout_height="4dp"
                                            app:cardBackgroundColor="@color/primary_container"
                                            app:cardCornerRadius="2dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="14"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar16"
                                            android:layout_width="24dp"
                                            android:layout_height="4dp"
                                            app:cardBackgroundColor="@color/primary_container"
                                            app:cardCornerRadius="2dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="16"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal"
                                        android:orientation="vertical">

                                        <com.google.android.material.card.MaterialCardView
                                            android:id="@+id/bar18"
                                            android:layout_width="24dp"
                                            android:layout_height="4dp"
                                            app:cardBackgroundColor="@color/primary_container"
                                            app:cardCornerRadius="2dp"
                                            app:cardElevation="0dp"
                                            app:strokeWidth="0dp" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="20dp"
                                            android:fontFamily="@font/nunito_regular"
                                            app:fontFamily="@font/nunito_regular"
                                            android:gravity="bottom"
                                            android:text="18"
                                            android:textColor="@color/muted"
                                            android:textSize="11sp" />
                                    </LinearLayout>
                                </LinearLayout>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Drink Breakdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.MTS.Text.Heading2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Drink breakdown"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_regular"
                        app:fontFamily="@font/nunito_regular"
                        android:text="Credited"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/listBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <!-- Item 1: Water -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="6dp"
                                android:layout_height="34dp"
                                app:cardBackgroundColor="@color/wave_blue"
                                app:cardCornerRadius="3dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    app:fontFamily="@font/nunito_bold"
                                    android:text="Water"
                                    android:textColor="@color/on_background"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:text="1,000 ml · 2 drinks"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                app:fontFamily="@font/nunito_extrabold"
                                android:text="1,000 ml"
                                android:textColor="@color/on_background"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Item 2: Coffee, hrsya gada coffee, nnt gnti-->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="6dp"
                                android:layout_height="34dp"
                                app:cardBackgroundColor="@color/coffee_brown"
                                app:cardCornerRadius="3dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    app:fontFamily="@font/nunito_bold"
                                    android:text="Coffee"
                                    android:textColor="@color/on_background"
                                    android:textSize="16sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    app:fontFamily="@font/nunito_regular"
                                    android:text="250 ml · 11:30 AM"
                                    android:textColor="@color/muted"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_extrabold"
                                app:fontFamily="@font/nunito_extrabold"
                                android:text="200 ml"
                                android:textColor="@color/on_background"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation -->
    <FrameLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@color/surface"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Widget.MTS.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_history"
                    app:tint="@color/on_background" />

                <TextView
                    style="@style/Widget.MTS.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:textColor="@color/on_background" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/navGoals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_water_drop"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Widget.MTS.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goals"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_person"
                    app:tint="@color/primary" />

                <TextView
                    style="@style/Widget.MTS.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:contentDescription="Add drink"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/primary"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>