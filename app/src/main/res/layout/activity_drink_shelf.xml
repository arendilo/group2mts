<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            style="@style/Widget.MTS.Text.Heading2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Your Drink Shelf" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.MTS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Widget.MTS.Text.Heading2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom Beverages (Coming Soon)" />

            <TextView
                style="@style/Widget.MTS.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Your 6 default drinks (Water 100%, Green tea 90%, Coffee 80%, Juice 95%, Milk 90%, Soda 80%) are seeded in Supabase and ready to log via the + button."
                android:textColor="@color/muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQuickLogNow"
                style="@style/Widget.MTS.Button.Dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Open Log Drink Screen" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>