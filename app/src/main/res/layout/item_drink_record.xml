<?xml version="1.0" encoding="utf-8"?>
<!-- One row inside the "Drink Record" card. Inflated once per record from MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Thin line above the row. MainActivity hides it for the first row. -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/on_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <!-- Blue circle with a white drop inside -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.MTS.Card"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:cardBackgroundColor="@color/primary"
            app:cardCornerRadius="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_water_drop"
                android:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRecordName"
                style="@style/Widget.MTS.Text.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="Water" />

            <TextView
                android:id="@+id/tvRecordTime"
                style="@style/Widget.MTS.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="11:30 AM" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRecordAmount"
            style="@style/Widget.MTS.Text.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            tools:text="500 ml" />
    </LinearLayout>
</LinearLayout>
